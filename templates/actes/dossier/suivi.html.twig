{% block inline_stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    /* ============================================================
       DOSSIER SUIVI - PREMIUM DESIGN
    ============================================================ */

    /* Modal overrides */
    #exampleModalSizeSm2 .modal-dialog {
        max-width: 95vw;
    }
    #exampleModalSizeSm2 .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,.25);
        font-family: 'Inter', sans-serif;
    }

    /* ---- HEADER ---- */
    .suivi-modal-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 20px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: none;
    }
    .suivi-modal-header .dossier-title {
        display: flex;
        flex-direction: column;
    }
    .suivi-modal-header .dossier-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        color: rgba(255,255,255,.5);
        text-transform: uppercase;
        margin-bottom: 2px;
    }
    .suivi-modal-header .dossier-name {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        letter-spacing: .3px;
    }
    .suivi-modal-header .close-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255,255,255,.1);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .2s;
        color: #fff;
    }
    .suivi-modal-header .close-btn:hover {
        background: rgba(255,255,255,.2);
    }

    /* ---- STEP WIZARD ---- */
    .suivi-steps-wrapper {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 0 28px 24px;
    }
    .suivi-steps-list {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 4px;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .suivi-steps-list::-webkit-scrollbar { display: none; }

    .li-step {
        flex: 1;
        min-width: 80px;
        position: relative;
    }

    /* Connector line between steps */
    .li-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 20px;
        right: -2px;
        width: 4px;
        height: 2px;
        background: rgba(255,255,255,.15);
        z-index: 1;
    }

    .li-step a.nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 6px 10px;
        border-radius: 10px;
        text-decoration: none;
        transition: all .25s ease;
        position: relative;
        border: 1.5px solid transparent;
        cursor: pointer;
    }

    /* Step number bubble */
    .li-step a.nav-link .step-num {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.5);
        border: 2px solid rgba(255,255,255,.15);
        margin-bottom: 6px;
        transition: all .25s ease;
        position: relative;
        z-index: 2;
    }

    .li-step a.nav-link .step-label {
        font-size: 9px;
        font-weight: 500;
        color: rgba(255,255,255,.4);
        text-align: center;
        line-height: 1.3;
        letter-spacing: .3px;
        max-width: 80px;
        transition: color .25s;
    }

    /* DONE state */
    .li-step.done a.nav-link {
        background: rgba(16,185,129,.08);
        border-color: rgba(16,185,129,.25);
    }
    .li-step.done a.nav-link .step-num {
        background: #10b981;
        border-color: #10b981;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(16,185,129,.2);
    }
    .li-step.done a.nav-link .step-num::after {
        content: '✓';
        position: absolute;
        font-size: 14px;
    }
    .li-step.done a.nav-link .step-num-text {
        display: none;
    }
    .li-step.done a.nav-link .step-label {
        color: #10b981;
    }

    /* ACTIVE state */
    .li-step.active a.nav-link {
        background: rgba(99,102,241,.15);
        border-color: rgba(99,102,241,.4);
    }
    .li-step.active a.nav-link .step-num {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(99,102,241,.25), 0 4px 12px rgba(99,102,241,.4);
        animation: pulse-active 2s infinite;
    }
    .li-step.active a.nav-link .step-label {
        color: #a5b4fc;
        font-weight: 600;
    }

    @keyframes pulse-active {
        0%, 100% { box-shadow: 0 0 0 4px rgba(99,102,241,.25), 0 4px 12px rgba(99,102,241,.4); }
        50%       { box-shadow: 0 0 0 8px rgba(99,102,241,.1),  0 4px 16px rgba(99,102,241,.5); }
    }

    /* Hover on non-disabled */
    .li-step a.nav-link[data-href]:hover {
        background: rgba(255,255,255,.07);
        border-color: rgba(255,255,255,.2);
        transform: translateY(-2px);
    }
    .li-step a.nav-link[data-href]:hover .step-num {
        border-color: rgba(255,255,255,.4);
        color: #fff;
    }
    .li-step a.nav-link:not([data-href]) {
        opacity: .5;
        cursor: not-allowed;
    }

    /* ---- BODY ---- */
    .suivi-modal-body {
        background: #f8fafc;
        padding: 24px 28px;
        min-height: 300px;
    }

    /* ---- FORM CONTENT AREA ---- */
    #form-content {
        min-height: 200px;
    }

    #form-content .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
    }
    #form-content .card-body {
        padding: 24px;
    }
    #form-content h3 {
        font-size: 16px;
        font-weight: 700;
        color: #0f3460;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e2e8f0;
    }
    #form-content h3::before {
        content: '';
        width: 4px;
        height: 20px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 2px;
        flex-shrink: 0;
    }

    /* Buttons */
    #form-content .btn-primary {
        background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: .3px;
        transition: all .2s;
        box-shadow: 0 4px 12px rgba(99,102,241,.3);
    }
    #form-content .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(99,102,241,.4);
    }
    #form-content .btn-success {
        background: linear-gradient(135deg, #10b981, #059669) !important;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-weight: 600;
        font-size: 13px;
        box-shadow: 0 4px 12px rgba(16,185,129,.3);
        transition: all .2s;
    }
    #form-content .btn-success:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(16,185,129,.4);
    }

    /* Loading skeleton */
    .step-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 48px 24px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
    }
    .step-loading .spinner-ring {
        width: 36px;
        height: 36px;
        border: 3px solid #e2e8f0;
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .step-loading span {
        font-size: 14px;
        font-weight: 500;
        color: #64748b;
    }

    /* ---- FOOTER ---- */
    .suivi-modal-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }
    .suivi-modal-footer .btn-close-modal {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s;
    }
    .suivi-modal-footer .btn-close-modal:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    /* Table overrides inside steps */
    #form-content .table-custom {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e2e8f0 !important;
    }
    #form-content .table-custom thead {
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        color: #fff;
    }
    #form-content .table-custom thead th {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .8px;
        text-transform: uppercase;
        padding: 12px 14px;
        border: none;
        color: rgba(255,255,255,.85);
    }
    #form-content .table-custom tbody tr {
        transition: background .15s;
    }
    #form-content .table-custom tbody tr:hover {
        background: #f0f4ff;
    }

    /* Empty state */
    .empty-steps-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 56px 24px;
        gap: 12px;
    }
    .empty-steps-state .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #fef3c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }
    .empty-steps-state p {
        font-size: 14px;
        color: #64748b;
        text-align: center;
        max-width: 320px;
        margin: 0;
    }

</style>
{% endblock %}

{% block page_content %}
    {# ========== HEADER ========== #}
    <div class="suivi-modal-header">
        <div class="dossier-title">
            <span class="dossier-label">Suivi de dossier</span>
            <span class="dossier-name">{{ dossier.objet | upper }}</span>
        </div>
        <button class="close-btn" data-bs-dismiss="modal" aria-label="Close" title="Fermer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect opacity="0.6" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor"/>
                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor"/>
            </svg>
        </button>
    </div>

    {# ========== STEP WIZARD ========== #}
    <div class="suivi-steps-wrapper">
        <ul id="smartwizard-3" class="suivi-steps-list">
        {% for etape in etapes %}
            {% set _index = loop.index %}
            {% if etape.propriete != 'infoClassification' %}
                {% set has_value = attribute(dossier, 'get' ~ (etape.propriete|title))|length %}
            {% else %}
                {% set has_value = attribute(dossier, 'get' ~ (etape.propriete|title))['id']|default(0) %}
            {% endif %}
            {% set is_current = (etape.route == dossier.etape) or (dossier.etape == '' and _index == 1) or (_index == 1 and not has_value and not dossier.etape) %}

            <li class="nav-item li-step
                {% if has_value %}has-value done{% endif %}
                {% if is_current and not has_value %}active{% endif %}
                {% if etape.route == dossier.etape %}active{% endif %}
            ">
                <a href="#{{ etape.route }}"
                   data-numero="{{ etape.numeroEtape }}"
                   class="nav-link"
                   title="{{ etape.libelleEtape }}"
                   {% if has_value or is_current %}data-href="{{ path(type_acte.code ~ '_' ~ etape.route, {id: dossier.id}) }}"{% endif %}>
                    <span class="step-num">
                        {% if has_value %}
                            <span class="step-check">✓</span>
                        {% else %}
                            <span class="step-num-text">{{ _index }}</span>
                        {% endif %}
                    </span>
                    <span class="step-label">{{ etape.libelleEtape }}</span>
                </a>
            </li>
        {% endfor %}
        </ul>
    </div>

    {# ========== BODY ========== #}
    <div class="suivi-modal-body">
        <div id="form-content">
            {% if etapes is empty %}
                <div class="empty-steps-state">
                    <div class="empty-icon">⚠️</div>
                    <p>Aucune étape de workflow n'est configurée et active pour le type d'acte : <strong>{{ dossier.typeActe ? dossier.typeActe.titre : 'Aucun' }}</strong>.</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# ========== FOOTER ========== #}
    <div class="suivi-modal-footer">
        <button type="button" class="btn-close-modal" data-bs-dismiss="modal">Fermer</button>
    </div>
{% endblock %}

{% block java %}
<script>
    $(function () {
        $('.no-auto').each(function () {
            const $this = $(this);
            const $id = $('#' + $this.attr('id'));
            init_date_picker($id, 'down', (start, e) => {}, null, null, false);
            $id.on('apply.daterangepicker', function (ev, picker) {
                $(this).val(picker.startDate.format('DD/MM/YYYY'));
            });
        });

        function load_content(url) {
            const $form_content = $('#form-content');
            $.ajax({
                url: url,
                method: 'GET',
                dataType: 'html',
                beforeSend: function () {
                    $form_content.html(`
                        <div class="step-loading">
                            <div class="spinner-ring"></div>
                            <span>Chargement de l'étape…</span>
                        </div>
                    `);
                },
                success: function (html) {
                    $form_content.hide().html(html).fadeIn(250);
                },
                error: function () {
                    $form_content.html(`
                        <div class="empty-steps-state">
                            <div class="empty-icon">❌</div>
                            <p>Une erreur est survenue lors du chargement de cette étape.</p>
                        </div>
                    `);
                }
            });
        }

        // Expose a global function for admin.js to call upon successful step validation
        window.suivi_load_next = function(urlObj) {
            if (urlObj && urlObj.url && urlObj.tab) {
                const hash = urlObj.tab;
                const $link = $('#smartwizard-3').find('[href="' + hash + '"]');
                const $li = $link.parent('li');
                $li.removeClass('d-none');
                
                if (urlObj.current) {
                    const $currentLink = $('#smartwizard-3').find('[href="' + urlObj.current + '"]');
                    $currentLink.parent('li').addClass('has-value done').removeClass('active is-current');
                }

                if (!$link.attr('data-href')) {
                    $link.attr('data-href', urlObj.url);
                }
                
                $link.trigger('click');
            }
        };

        $('#smartwizard-3').on('click shown.bs.tab', '.nav-link', function (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            const $this = $(this);
            if ($this.attr('data-href')) {
                load_content($this.attr('data-href'));
                const $parent = $this.closest('li');
                $parent.removeClass('done is-current').addClass('active');

                $('.li-step').not($parent).each(function () {
                    const $_this = $(this);
                    $_this.removeClass('active is-current');
                    if ($_this.hasClass('has-value')) {
                        $_this.addClass('done');
                    }
                    if ($_this.find('a').attr('data-href') && !$_this.hasClass('has-value')) {
                        $_this.addClass('is-current');
                    }
                });
            }
        });

        // Auto-load active step on open
        let activeHref = $('.li-step.active').first().find('a').attr('data-href');
        if (!activeHref) {
            // fallback: first step with data-href
            activeHref = $('.li-step').first().find('a[data-href]').attr('data-href');
        }
        if (activeHref) {
            load_content(activeHref);
        }
    });
</script>
{% endblock %}