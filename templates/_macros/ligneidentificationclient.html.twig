{% macro prototype_identification(form) %}
<div class="list-colonne" data-prototype="{{ _self.identification(form.identifications.vars.prototype)|e }}"></div>

<div class="id-table-wrapper">
    <table class="table table-custom id-table">
        <thead>
            <tr>
                <th colspan="5" class="text-center id-table-header-title">
                    <span>🧑‍💼</span> Identification des clients
                </th>
            </tr>
            <tr class="id-table-col-headers">
                <th width="28%">Type client</th>
                <th width="30%">Client concerné</th>
                <th width="20%">Attribut</th>
                <th width="16%">Montant à payer</th>
                <th width="6%" class="text-center">
                    <button type="button"
                            data-protoname="__name__"
                            class="btn btn-default add_line"
                            id="add_ligne"
                            data-protoclass=".list-colonne"
                            data-container=".column-container"
                            title="Ajouter une ligne">
                        <i class="fa fa-plus"></i> Ajouter
                    </button>
                </th>
            </tr>
        </thead>
        <tbody class="column-container proto-container" data-childclass="">
            {% for item in form.identifications %}
                {{ _self.identification(item|e) }}
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    .id-table-wrapper {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        margin-bottom: 0;
    }
    .id-table {
        margin-bottom: 0;
    }
    .id-table thead tr:first-child {
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
    }
    .id-table-header-title {
        color: rgba(255,255,255,.9) !important;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 12px 16px !important;
        border: none !important;
    }
    .id-table-header-title span {
        margin-right: 6px;
    }
    .id-table-col-headers {
        background: rgba(99,102,241,.08);
    }
    .id-table-col-headers th {
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #64748b;
        padding: 10px 14px;
        border-bottom: 2px solid #e2e8f0;
        border-top: none;
    }
    .id-table tbody tr {
        transition: background .15s;
        border-bottom: 1px solid #f1f5f9;
    }
    .id-table tbody tr:hover {
        background: #f8faff;
    }
    .id-table tbody td {
        padding: 10px 12px;
        vertical-align: middle;
    }
</style>
{% endmacro %}