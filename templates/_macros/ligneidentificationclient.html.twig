{% macro identification(colonne) %}

<tr class="row-colonne pointer">
    <td class="p-2">
        <div class="field-matiere">{{ form_widget(colonne.type) }}</div>
    </td>
    <td class="p-2">
        <div class="field-matiere">{{ form_widget(colonne.clients) }}</div>
    </td>
    <td class="p-2">
        <div class="field-matiere">{{ form_widget(colonne.attribut) }}</div>
    </td>
    <td class="p-2">
        <div class="field-matiere">{{ form_widget(colonne.montant) }}</div>
    </td>
    <td class="p-2 del-col text-center" data-parent=".row-colonne">
        {# <a href="#" class="btn btn-danger btn-xs"><span class="bi bi-trash"></span></a> #}
    </td>
</tr>

